{
  "name": "pingme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run check && wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "db:local": "wrangler d1 execute pingme-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute pingme-db --remote --file=./schema.sql",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.41.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
